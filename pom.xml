<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.nkap</groupId>
  <artifactId>nkap-parent</artifactId>
  <version>2.3.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Nkap</name>
  <description>An open mobile money gateway with a real double-entry ledger.</description>
  <url>https://nkap.dev</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>core</module>
    <module>provider-api</module>
    <module>provider-mtn</module>
    <module>provider-mpesa</module>
    <module>conformance</module>
    <module>test-support</module>
    <module>simulator-core</module>
    <module>simulator-mtn</module>
    <module>simulator-mpesa</module>
    <module>simulator</module>
    <module>simulator-mpesa-app</module>
    <module>server</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <spring-boot.version>3.5.16</spring-boot.version>
    <!--
      Overrides of versions spring-boot-dependencies manages (issue #282), each answering a
      finding of the dependency scan in .github/workflows/vulnerability-check.yml. Boot 3.5.16
      manages tomcat 10.1.55 and postgresql 42.7.11. Both are patch-level moves within the
      line, and each can go when the Boot line this project is on manages a version at or above
      it: drop the property and its dependencyManagement entries below, and check the scan.

      The names are Boot's own (tomcat.version, postgresql.version) so they read as what they
      override, but a property alone does nothing here: this POM imports the Boot BOM, it is not
      a child of it, and an importing POM's properties do not reach the imported one's
      ${tomcat.version}. That is why the entries below exist. Tried: with the properties only,
      `mvn dependency:tree` still resolved 10.1.55 and 42.7.11.
    -->
    <!-- CVE-2026-65637 (9.8, an incomplete fix for CVE-2026-32990, affects 10.1.53 - 10.1.57):
         fixed in 10.1.58. CVE-2026-68763 (7.5, HTTP/2) is fixed there too. -->
    <tomcat.version>10.1.61</tomcat.version>
    <!-- CVE-2026-54291 (channelBinding=require silently downgraded, affects 42.7.4 - 42.7.11):
         fixed in 42.7.12. -->
    <postgresql.version>42.7.14</postgresql.version>
    <!--
      Jackson, pinned AHEAD of Spring Boot (issue #301). Boot 3.5.16 manages jackson-bom 2.21.4, and
      five advisories name that version as affected: CVE-2026-89407 and CVE-2026-89425
      (jackson-core, fixed in 2.21.7), CVE-2026-91776 and CVE-2026-91777 (jackson-databind, fixed in
      2.21.7) and CVE-2026-68497 (jackson-databind, fixed in 2.21.6). The scan in
      .github/workflows/vulnerability-check.yml cannot see them, because the NVD has not analysed
      them: their records carry no CPE data, and that scan matches by CPE. The image scan found them.
      2.21.8 is the newest 2.21.x on Maven Central (2026-11-07), above every fixed version named.

      This one works differently from tomcat.version and postgresql.version above. It is not read by
      a dependencyManagement entry for each artifact: it is the version of an imported BOM, declared
      BEFORE the Boot BOM below. Tried, on this POM, with `mvn dependency:tree` on the server and the
      simulator: the property alone changes nothing (still 2.21.4); the import before the Boot
      import resolves 2.21.8; the same import after it resolves 2.21.4, since the first declaration
      wins.

      THE COST: this pins Jackson ahead of Boot, so a Boot upgrade whose BOM manages a newer Jackson
      silently keeps our older pin, and nothing here notices. When the Boot line this project is on
      manages a Jackson at or above this version, DROP the property and the import entry below. The
      audit page (docs/rules-and-their-instruments.md) lists that as an omission, because nothing
      enforces it.
    -->
    <jackson-bom.version>2.21.8</jackson-bom.version>
    <dependency-check.version>12.2.2</dependency-check.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        The overrides the properties above name. A version declared here beats the one the
        imported Boot BOM manages, whatever the order. All three embedded tomcat artifacts move
        together: spring-boot-starter-tomcat brings core, el and websocket at one version, and
        a container whose jars disagree is not one anyone has tested.
      -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        Jackson's BOM, imported before Boot's so that its versions win (see jackson-bom.version
        above for why, and for what this costs).
      -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        Spring Boot is used by simulator and server only. Imported as a BOM, not
        as the project parent, so core and provider-api stay Spring-free.
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.nkap</groupId>
        <artifactId>nkap-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.nkap</groupId>
        <artifactId>nkap-provider-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      A scan of the dependency tree this project ships, for known vulnerabilities (issue #280).
      Off by default: `mvn clean verify` does not run it and does not download its data. Run it
      with `mvn -B -P security-check verify`; .github/workflows/vulnerability-check.yml does,
      daily and on pull requests that change a POM. The first run downloads the NVD data (about
      200 MB) and takes minutes; later runs reuse it.

      What it fails on: any dependency with a CVSS score of 7 or more. Test-scope dependencies
      are not scanned (the plugin's default), because they are not what an operator runs.

      What it reports: target/dependency-check-report.html, at the root, one report for the
      whole reactor (the `aggregate` goal).
    -->
    <profile>
      <id>security-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <executions>
              <execution>
                <goals>
                  <goal>aggregate</goal>
                </goals>
                <phase>verify</phase>
              </execution>
            </executions>
            <configuration>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <!--
                The NVD's API key, read from the environment. CI sets it from the repository
                secret NVD_API_KEY. Unset, as on most machines, the scan falls back to the
                unauthenticated download, which works and is a good deal slower and more
                likely to be rate-limited.
              -->
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
              <!--
                Sonatype's OSS Index needs an account this project does not have, and without
                one it logs errors on every run. The NVD stays the source of vulnerabilities.
              -->
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <!--
                Anchored at the directory Maven was started in, which is the root: with
                `aggregate` a path relative to each module would not find the one file.
                Every suppression in it must carry an `until` date; the header says why.
              -->
              <suppressionFiles>
                <suppressionFile>${session.executionRootDirectory}/dependency-check-suppressions.xml</suppressionFile>
              </suppressionFiles>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
