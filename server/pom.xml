<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.nkap</groupId>
    <artifactId>nkap-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>nkap-server</artifactId>
  <name>Nkap :: Server</name>

  <dependencies>
    <dependency>
      <groupId>dev.nkap</groupId>
      <artifactId>nkap-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.nkap</groupId>
      <artifactId>nkap-provider-api</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.nkap</groupId>
      <artifactId>nkap-provider-mtn</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- The state lives in PostgreSQL: plain SQL through JdbcTemplate, Flyway for the schema. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests drive a real MTN adapter against a real simulator, over HTTP. -->
    <dependency>
      <groupId>dev.nkap</groupId>
      <artifactId>nkap-simulator</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The integration tests (*IT) run against a real PostgreSQL in a container. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Spring MVC binds @PathVariable / @RequestHeader by parameter name. -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <!--
        *Test  -> surefire, unit and web-slice tests, no Docker.
        *IT    -> failsafe, Testcontainers against a real PostgreSQL. Each *IT is
        skipped when Docker is unavailable (see DockerAvailable), so `mvn verify`
        stays green on a machine without Docker; CI (ubuntu-latest) has it.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
