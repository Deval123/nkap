<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.nkap</groupId>
  <artifactId>nkap-parent</artifactId>
  <version>2.3.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Nkap</name>
  <description>An open mobile money gateway with a real double-entry ledger.</description>
  <url>https://nkap.dev</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>core</module>
    <module>provider-api</module>
    <module>provider-mtn</module>
    <module>provider-mpesa</module>
    <module>conformance</module>
    <module>test-support</module>
    <module>simulator-core</module>
    <module>simulator-mtn</module>
    <module>simulator-mpesa</module>
    <module>simulator</module>
    <module>simulator-mpesa-app</module>
    <module>server</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <spring-boot.version>3.5.16</spring-boot.version>
    <dependency-check.version>12.2.2</dependency-check.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        Spring Boot is used by simulator and server only. Imported as a BOM, not
        as the project parent, so core and provider-api stay Spring-free.
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.nkap</groupId>
        <artifactId>nkap-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.nkap</groupId>
        <artifactId>nkap-provider-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      A scan of the dependency tree this project ships, for known vulnerabilities (issue #280).
      Off by default: `mvn clean verify` does not run it and does not download its data. Run it
      with `mvn -B -P security-check verify`; .github/workflows/vulnerability-check.yml does,
      daily and on pull requests that change a POM. The first run downloads the NVD data (about
      200 MB) and takes minutes; later runs reuse it.

      What it fails on: any dependency with a CVSS score of 7 or more. Test-scope dependencies
      are not scanned (the plugin's default), because they are not what an operator runs.

      What it reports: target/dependency-check-report.html, at the root, one report for the
      whole reactor (the `aggregate` goal).
    -->
    <profile>
      <id>security-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <executions>
              <execution>
                <goals>
                  <goal>aggregate</goal>
                </goals>
                <phase>verify</phase>
              </execution>
            </executions>
            <configuration>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <!--
                The NVD's API key, read from the environment. CI sets it from the repository
                secret NVD_API_KEY. Unset, as on most machines, the scan falls back to the
                unauthenticated download, which works and is a good deal slower and more
                likely to be rate-limited.
              -->
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
              <!--
                Sonatype's OSS Index needs an account this project does not have, and without
                one it logs errors on every run. The NVD stays the source of vulnerabilities.
              -->
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <!--
                Anchored at the directory Maven was started in, which is the root: with
                `aggregate` a path relative to each module would not find the one file.
                Every suppression in it must carry an `until` date; the header says why.
              -->
              <suppressionFiles>
                <suppressionFile>${session.executionRootDirectory}/dependency-check-suppressions.xml</suppressionFile>
              </suppressionFiles>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
